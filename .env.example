# Variables de entorno para LLM-FineTuner
# Copiar a .env y editar según sea necesario

# Token de HuggingFace (opcional, para modelos privados)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Configuración del modelo (pueden sobreescribir config.yaml)
LLMFT_MODEL_BASE=Qwen/Qwen2.5-7B-Instruct
LLMFT_MODEL_QUANTIZATION=nf4
LLMFT_MODEL_DEVICE=auto

# Configuración de entrenamiento
LLMFT_TRAINING_LORA_RANK=16
LLMFT_TRAINING_LORA_ALPHA=32
LLMFT_TRAINING_EPOCHS=3
LLMFT_TRAINING_BATCH_SIZE=2
LLMFT_TRAINING_MAX_SEQ_LENGTH=4096
LLMFT_TRAINING_LEARNING_RATE=2e-4

# Configuración de datos
LLMFT_DATA_INPUT_DIR=data/raw
LLMFT_DATA_PROCESSED_DIR=data/processed
LLMFT_DATA_MIN_LENGTH=10
LLMFT_DATA_MAX_LENGTH=4096

# Configuración de Ollama
LLMFT_OLLAMA_MODEL_NAME=finetuned-qwen2.5-7b
LLMFT_OLLAMA_TEMPLATE=qwen2.5
LLMFT_OLLAMA_PORT=11434

# Ruta al ejecutable de Ollama (opcional)
LLMFT_OLLAMA_PATH=C:/Program Files/Ollama/ollama.exe

# Configuración de logging
LLMFT_LOGGING_LEVEL=INFO
LLMFT_LOGGING_DIR=data/logs
